# ============================================================
# DCS Auth Service Configuration
# Copy this file to `.env` and adjust the values.
# All runtime configuration lives here — no hardcoded secrets.
# ============================================================

# --- Server ---
# Port the auth service listens on.
PORT=8787
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite file path. Change to a mounted volume path in production.
DATABASE_PATH=./data/dcs.db

# --- Secrets ---
# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED — the service refuses to start without it.
JWT_SECRET=ym8VccE3uLkiOCJM3qxYWiSkC3jLpEqf2_bXlu28KZAybfIlOMbquyeExQ2AoO4U
# Access token lifetime (seconds).
ACCESS_TOKEN_TTL=900
# Refresh token lifetime (seconds).
REFRESH_TOKEN_TTL=2592000

// --- Public base URL (for OAuth redirect URI) ---
# Public URL of the auth service as seen from the browser/network.
# Defaults to http://localhost:{PORT} when unset.
PUBLIC_API_URL=http://localhost:8787

# --- Google OAuth (optional) ---
# From https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {API_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password Reset (optional) ---
# Base URL of the frontend, used to build reset links.
APP_URL=http://localhost:5173
# SMTP credentials for sending reset emails. If empty, reset tokens
# are logged to the server console (development mode only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DCS <no-reply@localhost>"

# --- Bootstrap admin (first run only) ---
# Created on startup if the users table is empty. REMOVE after first login.
ADMIN_WORK_ID=admin
ADMIN_EMAIL=daproot0@gmail.com
ADMIN_PASSWORD=admin123
